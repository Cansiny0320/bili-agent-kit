{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": { "@bili-agent-kit/core": ["./packages/core/src/index.ts"] }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
